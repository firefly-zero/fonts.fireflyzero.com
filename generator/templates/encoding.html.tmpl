{{define "title"}}{{.Encoding.Title}} fonts for Firefly Zero{{end}}

{{define "body"}}
  <h1 class="text-center">
    <a href="https://fireflyzero.com/" target="_blank">Firefly Zero</a> / <a href="..">Fonts</a> / {{.Encoding.Emoji}} {{.Encoding.Title}}
  </h1>

  <div class="alert alert-light" role="alert">
    Don't know which font to pick? The <a href="ucs.html">ucs</a> font family 
    is a safe choice. Firefly UI uses <a href="ucs-6x9.fff" download>ucs-6x9</a>.
  </div>

  <div class="row">
    <div class="col col-2">
      <label for="min-w-input" class="form-label">
        <i class="fa-solid fa-text-width fa-fw"></i>
        minimum width
        (≥<output for="min-w-input" id="min-w-output" class="text-danger-emphasis" aria-hidden="true"></output>)
      </label>
    </div>
    <div class="col col-10">
      <input type="range" class="form-range" min=4 max=32 value=4 step=1 id="min-w-input">
    </div>

    <div class="col col-2">
      <label for="max-w-input" class="form-label">
        <i class="fa-solid fa-text-width fa-fw"></i>
        maximum width
        (≤<output for="max-w-input" id="max-w-output" class="text-danger-emphasis" aria-hidden="true"></output>)
      </label>
    </div>
    <div class="col col-10">
      <input type="range" class="form-range" min=4 max=32 value=32 step=1 id="max-w-input">
    </div>

    <div class="col col-2">
      <label for="min-h-input" class="form-label">
        <i class="fa-solid fa-text-height fa-fw"></i>
        minimum height
        (≥<output for="min-h-input" id="min-h-output" class="text-danger-emphasis" aria-hidden="true"></output>)
      </label>
    </div>
    <div class="col col-10">
      <input type="range" class="form-range" min=4 max=64 value=4 step=1 id="min-h-input">
    </div>

    <div class="col col-2">
      <label for="max-h-input" class="form-label">
        <i class="fa-solid fa-text-height fa-fw"></i>
        maximum height
        (≤<output for="max-h-input" id="max-h-output" class="text-danger-emphasis" aria-hidden="true"></output>)
      </label>
    </div>
    <div class="col col-10">
      <input type="range" class="form-range" min=4 max=64 value=64 step=1 id="max-h-input">
    </div>

    <script>
      const minWIn = document.getElementById('min-w-input');
      const minWOut = document.getElementById('min-w-output');
      minWOut.textContent = minWIn.value;

      const maxWIn = document.getElementById('max-w-input');
      const maxWOut = document.getElementById('max-w-output');
      maxWOut.textContent = maxWIn.value;

      const minHIn = document.getElementById('min-h-input');
      const minHOut = document.getElementById('min-h-output');
      minHOut.textContent = minHIn.value;

      const maxHIn = document.getElementById('max-h-input');
      const maxHOut = document.getElementById('max-h-output');
      maxHOut.textContent = maxHIn.value;

      function updateList() {
        const minW = minWIn.value;
        minWOut.textContent = minW;
        const maxW = maxWIn.value;
        maxWOut.textContent = maxW;

        const minH = minHIn.value;
        minHOut.textContent = minH;
        const maxH = maxHIn.value;
        maxHOut.textContent = maxH;

        const fonts = document.getElementsByTagName('article');
        for (let i = 0; i < fonts.length; i++) {
          const font = fonts[i];
          const wgt  = Number(font.dataset.charw) >= Number(minW);
          const wlt  = Number(font.dataset.charw) <= Number(maxW);
          const hgt  = Number(font.dataset.charh) >= Number(minH);
          const hlt  = Number(font.dataset.charh) <= Number(maxH);
          if (wgt && wlt && hgt && hlt) {
            font.style.display = "";
          } else {
            font.style.display = "none";
          }
        }
      }

      minWIn.addEventListener('input', updateList);
      maxWIn.addEventListener('input', updateList);
      minHIn.addEventListener('input', updateList);
      maxHIn.addEventListener('input', updateList);
    </script>
  </div>

  <div class="row row-cols-1 row-cols-md-2 g-1">
    {{range .Fonts}}
      <article class="col" data-charw="{{.Width}}" data-charh="{{.Height}}">
        {{template "card" .}}
      </article>
    {{end}}
  </div>
{{end}}

{{template "base" .}}
